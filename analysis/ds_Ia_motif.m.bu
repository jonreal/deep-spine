function motif = ds_Ia_motifs(W,opt)
  arguments
    W
    opt.show_basis = false
  end

  [m,n] = size(W{1});
  assert(m == n,'Dim mismatch');

  S_template = [ ...
    1, 0, zeros(1,n-2);
    0, 1, zeros(1,n-2); ...
    zeros(n-2,n)];
  bS = ...
        arrayfun(@(i) ...
          arrayfun(@(j) ...
            reshape(circshift(S_template, [i j]),[],1), ...
            [0:2:(n-2)],'UniformOutput',0), ...
          [0:2:(n-2)],'UniformOutput',0);

  A_template = [ ...
    0, 1, zeros(1,n-2);
    1, 0, zeros(1,n-2); ...
    zeros(n-2,n)];
  bA = ...
        arrayfun(@(i) ...
          arrayfun(@(j) ...
            reshape(circshift(A_template, [i j]),[],1), ...
            [0:2:(n-2)],'UniformOutput',0), ...
          [0:2:(n-2)],'UniformOutput',0);

  bR = cell2mat(arrayfun(@(i) bS{i}{i}, 1:(n/2), 'UniformOutput',0))

  for i=1:(n/2)
    bS{i}(i) = []
  end

  bS_mat = cell2mat(cellfun(@(x) [x{:}], bS, 'UniformOutput', false));
  bA_mat = cell2mat(cellfun(@(x) [x{:}], bA, 'UniformOutput', false));
  B = [bR, bS_mat, bA_mat];


  Binv = pinv(B);
  c = [cellfun(@(Wq) Binv*Wq(:), W,'UniformOutput',0)];
  residual = cell2mat(...
    [cellfun(@(Wq,cq) norm(Wq(:) - B*cq), W,c,'UniformOutput',0)])';

  motif.c = cell2mat(c)';
  motif.residual = residual;

  % Create synergy masks
  mask.R = reshape(logical(sum(bR,2)),n,n);
  mask.S = reshape(logical(sum(bS_mat,2)),n,n);
  mask.A = reshape(logical(sum(bA_mat,2)),n,n);

  mask.Rn = arrayfun(@(i) reshape(logical(bR(:,i)),n,n),1:(n/2), ...
    'UniformOutput',0);
  mask.Sn = arrayfun(@(i) reshape(logical(bS_mat(:,i)),n,n),1:(n/2), ...
    'UniformOutput',0);
  mask.An = arrayfun(@(i) reshape(logical(bA_mat(:,i)),n,n),1:(n/2), ...
    'UniformOutput',0);

  % Additive synergy analysis
  motif.R_a = ...
    [cellfun(@(Wq) sum(Wq(mask.R), 'all') ./ sum(mask.R,'all'), W)]';
  motif.S_a = ...
    [cellfun(@(Wq) sum(Wq(mask.S), 'all') ./ sum(mask.S,'all'), W)]';
  motif.A_a = ...
    [cellfun(@(Wq) sum(Wq(mask.A), 'all') ./ sum(mask.A,'all'), W)]';

  % Multiplicative synergy analysis
  motif.R_m = ...
    [cellfun(@(Wq) prod(Wq(mask.R), 'all').^(1/sum(mask.R,'all')), W)]';
  motif.S_m = ...
    [cellfun(@(Wq) prod(Wq(mask.S), 'all').^(1/sum(mask.S,'all')), W)]';
  motif.A_m = ...
    [cellfun(@(Wq) prod(Wq(mask.A), 'all').^(1/sum(mask.A,'all')), W)]';

  motif.mask = mask;

  if opt.show_basis

    figure;
    n = size(bR,2);
    for i=1:n
      subplot(1,n,i)
      imagesc(reshape(bR(:,i),6,6))
    end

    figure;
      n = numel(bS)
      for i=1:n
        for j=1:(n-1)
          j + (i-1)*(n-1)
          subplot(1,n*(n-1), j + (i-1)*(n-1));
          imagesc(reshape(bS{i}{j},6,6));
          title(['(',num2str(i),num2str(j),')']);
        end
      end

    figure;
      n = numel(bA)
      for i=1:n
        for j=1:n
          subplot(n,n, j + (i-1)*n);
          imagesc(reshape(bA{i}{j},6,6));
          title(['(',num2str(i),num2str(j),')']);
        end
      end
  end

end
