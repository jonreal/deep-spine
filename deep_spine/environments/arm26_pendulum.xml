<mujoco model="2-link 6-muscle arm">

  <option timestep="0.005" gravity="9.81 0 0">
    <flag gravity="enable"/>
  </option>

  <default>
    <joint
      type="hinge" pos="0 0 0" axis="0 0 1"
      limited="true" range="-120 120"
      damping="0.1"
    />
    <muscle
      scale="200" ctrllimited="true" ctrlrange="0 1"
      range="0.7 1.5"
      lmin="0.7" lmax="1.5"
    />
  </default>

  <asset>
    <texture
      type="skybox" builtin="gradient"
      rgb1="0 0 0" rgb2="0 0 0" width="512" height="512"/>

    <texture name="texplane" type="2d"
      builtin="checker" rgb1=".25 .25 .25" rgb2=".3 .3 .3"
      width="128" height="128" mark="cross" markrgb=".8 .8 .8"/>

    <material name="matplane" reflectance="0"
      texture="texplane" texrepeat="1 1" texuniform="true"/>

  </asset>

  <visual>
    <rgba actuator="0.1 0 0 1" actuatorpositive="1 0 0 1"/>
    <map actuatortendon="1.25"/>
  </visual>

  <worldbody>
    <geom name="floor" pos="0 0 -0.5" size="0 0 1"
      type="plane" material="matplane"/>

    <light directional="false" diffuse=".8 .8 .8"
      specular=".2 .2 .2" pos="0 0 10" dir="0 0 -1" castshadow="false"/>

    <site name="SFo" pos="-0.25 0.02 0" size="0.02"/>
    <site name="SEo" pos="-0.25 -0.02 0" size="0.02"/>

    <site name="BFo" pos="-0.15 0.005 0" size="0.02"/>
    <site name="BEo" pos="-0.15 -0.005 0" size="0.02"/>

    <site name="SFx" pos="0 0.15 0" size="0.02" rgba="1 .7 0 0.1" group="1"/>
    <site name="SEx" pos="0 -0.15 0" size="0.02" rgba="1 .7 0 0.1" group="1"/>

    <body pos="0 0 0">
      <geom name="upper arm"
        type="capsule" size="0.025" fromto="0 0 0  0.5 0 0"
        rgba="0.05 0.05 0.2 1" mass="2"/>

      <joint name="shoulder" limited="true" range="-120 120"/>

      <geom name="shoulder"
        type="cylinder" pos="0 0 0" size=".075 .05"
        rgba="0 0 0 0.8" mass="0" group="1"/>

      <site name="SFi" pos="0.075 -0.01 0" size="0.02"/>
      <site name="SEi" pos="0.075 0.01 0" size="0.02"/>
      <site name="BFv" pos="0.25 0.02 0" size="0.02"/>
      <site name="BEv" pos="0.25 -0.02 0" size="0.02"/>
      <site name="EFo" pos="0.35 0.03 0" size="0.02"/>
      <site name="EEo" pos="0.35 -0.03 0" size="0.02"/>

      <site name="EFx" pos="0.5 0.15 0"
        size="0.02" rgba="1 .7 0 0.1" group="1"/>
      <site name="EEx" pos="0.5 -0.15 0"
        size="0.02" rgba="1 .7 0 0.1" group="1"/>

      <body pos="0.5 0 0">

        <geom name="forearm"
          type="capsule" size="0.025" fromto="0 0 0  0.5 0 0"
          rgba="0.05 0.05 0.2 1" mass="1"/>

        <joint name="elbow"/>

        <geom name="elbow" type="cylinder" pos="0 0 0"
          size=".075 .05" rgba="0 0 0 0.8" mass="0" group="1"/>

        <site name="EFi" pos="0.075 0.01 0" size="0.02"/>
        <site name="EEi" pos="0.075 -0.01 0" size="0.02"/>

        <body pos="0.5 0 0">

          <geom name="pendulum"
            type="capsule" size="0.015" fromto="0 0 0
            0.35 0 0" rgba=".1 .1 .1 0.5" mass="0.25"/>

          <joint name="wrist" limited="false" damping="0.1"/>
          <geom name="wrist" type="cylinder"
            pos="0 0 0" size=".035 .05" rgba="0 0 0 0.9" mass="0" group="1"/>

          <body pos="0.35 0 0">
            <geom name="pendulum-end"
              type="cylinder" pos="0 0 0" size=".025 .05"
              rgba=".0 .0 .0 1" mass="0" group="1"/>
          </body>
        </body>
      </body>
    </body>

  </worldbody>

  <tendon>
    <spatial name="SF" width="0.01">
      <site site="SFo"/>
      <geom geom="shoulder" sidesite="SFx"/>
      <site site="SFi"/>
    </spatial>

    <spatial name="SE" width="0.01">
      <site site="SEo"/>
      <geom geom="shoulder" sidesite="SEx"/>
      <site site="SEi"/>
    </spatial>

    <spatial name="EF" width="0.01">
      <site site="EFo"/>
      <geom geom="elbow" sidesite="EFx"/>
      <site site="EFi"/>
    </spatial>

    <spatial name="EE" width="0.01">
      <site site="EEo"/>
      <geom geom="elbow" sidesite="EEx"/>
      <site site="EEi"/>
    </spatial>

    <spatial name="BF" width="0.009" rgba=".1 .1 .1 0.5">
      <site site="BFo"/>
      <geom geom="shoulder" sidesite="SFx"/>
      <site site="SEi"/>
      <site site="BFv"/>
      <geom geom="elbow" sidesite="EFx"/>
      <site site="EFi"/>
    </spatial>

    <spatial name="BE" width="0.009" rgba=".1 .1 .1 0.5">
      <site site="BEo"/>
      <geom geom="shoulder" sidesite="SEx"/>
      <site site="SFi"/>
      <site site="BEv"/>
      <geom geom="elbow" sidesite="EEx"/>
      <site site="EEi"/>
    </spatial>
  </tendon>

  <actuator>
    <muscle name="SF" tendon="SF"/>
    <muscle name="SE" tendon="SE"/>
    <muscle name="EF" tendon="EF"/>
    <muscle name="EE" tendon="EE"/>
    <muscle name="BF" tendon="BF"/>
    <muscle name="BE" tendon="BE"/>

    <motor name="WMotor"
      gear="1 0 0" joint="wrist" ctrllimited="true" ctrlrange="-1 1"/>


    <!--
    <motor name="SMotor" gear="10 0 0" joint="shoulder" ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="EMotor" gear="10 0 0" joint="elbow" ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="WMotor" gear="10 0 0" joint="wrist" ctrllimited="true" ctrlrange="-1 1"/>
    -->
  </actuator>

</mujoco>
