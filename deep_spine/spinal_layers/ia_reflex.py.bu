from deep_spine.spinal_layers.spinal_layers import *

class IaReflex(nn.Module):
    def __init__(
        self,
        num_motor_units = 6,
        II_length_gain = 0,
        II_bias = 0,
        Ia_II_gain = 0,
        Ia_bias = 0,
        Ia_saturation_constant = 0,
        Ia_velocity_bias = 0,
        MN_bias = 0
        ):
        super().__init__()
        self.n = num_motor_units

        self.II = II(
            self.n,
            bias=II_bias,
            length_gain=II_length_gain
        )
        self.Ia = Ia(
            self.n,
            II_gain=Ia_II_gain,
            saturation_constant=Ia_saturation_constant
        )
        self.aMN = aMN(
            self.n,
            bias=MN_bias
        )

    def forward(self, features):
        # Features: [length, velocity, a_MN, descending_drive]
        # Action: [activation_Ia, activation_MN]
        length = features[:,:self.n]
        print(f'length: {length}')
        velocity = features[:,self.n:self.n*2]
        activation_MN = features[:,self.n*2:self.n*3]
        descending_drive = features[:,self.n*3:]

        print('end-forward')
        activation_II = self.II(length, activation_MN)
        activation_Ia = self.Ia(velocity, activation_II, activation_MN)
        activation_MN = self.aMN(activation_Ia, descending_drive)


        print('end-forward')
        return torch.cat([activation_II, activation_Ia, activation_MN], dim=1)

class IaReflexActorCritic(nn.Module):
    def __init__(
        self,
        num_motor_units: int = 6,
        II_length_gain: float = 0,
        II_bias: float = 0,
        Ia_II_gain: float = 0,
        Ia_bias: float = 0,
        Ia_saturation_constant: float = 0,
        Ia_velocity_bias: float = 0,
        MN_bias: float = 0,
        nn_size_critic: int = 64,
    ):
        super().__init__()

        self.latent_dim_pi = 2*num_motor_units
        self.latent_dim_vf = nn_size_critic

        self.policy_net = IaReflex(
            num_motor_units=num_motor_units,
            II_length_gain=II_length_gain,
            II_bias=II_bias,
            Ia_II_gain=Ia_II_gain,
            Ia_bias=Ia_bias,
            Ia_saturation_constant=Ia_saturation_constant,
            Ia_velocity_bias=Ia_velocity_bias,
            MN_bias=MN_bias
        )
        self.value_net = nn.Sequential(
            nn.Linear(
                4*num_motor_units,
                nn_size_critic
            ),
            nn.Tanh(),
            nn.Linear(nn_size_critic, nn_size_critic),
            nn.Tanh()
        )

    def forward(
        self,
        features: torch.Tensor
    ) -> Tuple[torch.Tensor, torch.Tensor]:
        return self.forward_actor(features), self.forward_critic(features)

    def forward_actor(self, features: torch.Tensor) -> torch.Tensor:
        return self.policy_net(features)

    def forward_critic(self, features: torch.Tensor) -> torch.Tensor:
        return self.value_net(features)

class IaReflexPolicy(ActorCriticPolicy):
    def __init__(
        self,
        observation_space: spaces.Space,
        action_space: spaces.Space,
        lr_schedule: Callable[[float], float],
        num_motor_units: int = 6,
        II_length_gain: float = 0,
        II_bias: float = 0,
        Ia_II_gain: float = 0,
        Ia_bias: float = 0,
        Ia_saturation_constant: float = 0,
        Ia_velocity_bias: float = 0,
        MN_bias: float = 0,
        nn_size_critic: int = 64,
        *args,
        **kwargs
    ):
        self.num_motor_units = num_motor_units
        self.II_length_gain = II_length_gain
        self.II_bias = II_bias
        self.Ia_II_gain = Ia_II_gain
        self.Ia_bias = Ia_bias
        self.Ia_saturation_constant = Ia_saturation_constant
        self.Ia_velocity_bias = Ia_velocity_bias
        self.MN_bias = MN_bias
        self.nn_size_critic = nn_size_critic

        # Disable orthogonal initialization
        kwargs["ortho_init"] = False
        super().__init__(
            observation_space,
            action_space,
            lr_schedule,
            # Pass remaining arguments to base class
            *args,
            **kwargs,
        )
        self.action_net = nn.Identity()

    def _build_mlp_extractor(self) -> None:
        self.mlp_extractor = IaReflexActorCritic(
            num_motor_units=self.num_motor_units,
            II_length_gain=self.II_length_gain,
            II_bias=self.II_bias,
            Ia_II_gain=self.Ia_II_gain,
            Ia_bias=self.Ia_bias,
            Ia_saturation_constant=self.Ia_saturation_constant,
            Ia_velocity_bias=self.Ia_velocity_bias,
            MN_bias=self.MN_bias,
            nn_size_critic=self.nn_size_critic
        )

    def forward(
        self, obs: torch.Tensor, deterministic: bool = False
        ) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
        """
        Forward pass in all the networks (actor and critic)

        :param obs: Observation
        :param deterministic: Whether to sample or use deterministic actions
        :return: action, value and log probability of the action
        """
        features = self.extract_features(obs)
        if self.share_features_extractor:
            latent_pi, latent_vf = self.mlp_extractor(features)
        else:
            pi_features, vf_features = features
            latent_pi = self.mlp_extractor.forward_actor(pi_features)
            latent_vf = self.mlp_extractor.forward_critic(vf_features)
        values = self.value_net(latent_vf)
        distribution = self._get_action_dist_from_latent(latent_pi)
        actions = distribution.get_actions(deterministic=True)
        log_prob = distribution.log_prob(actions)
        actions = actions.reshape((-1, *self.action_space.shape)) 
        return actions, values, log_prob
